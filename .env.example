POSTGRES_USER=leanforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leanforge
WEBAPI_HOST_PORT=8081

MINIO_ROOT_USER=leanforge-minio
MINIO_ROOT_PASSWORD=change-me

DefaultAuth__JwtKey=change-me-32-chars-minimum-signing-key
PmiAuth__ClientId=change-me
PmiAuth__ClientSecret=change-me
PmiAuth__OpenIdConfigurationUrl=https://pmi.example.com/.well-known/openid-configuration

GoogleAuth__ClientId=change-me
GoogleAuth__ClientSecret=change-me

# Robokassa payment gateway (lf-paymentservice). MerchantLogin + both passwords come from the
# Robokassa merchant cabinet; HashAlgorithm must match the algorithm selected there (MD5/SHA256/SHA512).
# Set IsTest=true to route payments through Robokassa's test environment.
Robokassa__MerchantLogin=change-me
Robokassa__Password1=change-me
Robokassa__Password2=change-me
Robokassa__HashAlgorithm=SHA256
Robokassa__IsTest=true
# Public browser-return URLs (SPA routes served by lf-webapi). Robokassa also needs the ResultURL
# webhook — https://<your-host>/api/payments/robokassa/result — configured in the merchant cabinet.
Robokassa__SuccessUrl=https://leanforge.example.com/payments/success
Robokassa__FailUrl=https://leanforge.example.com/payments/fail

# Sentry error monitoring for the backend services (LF.WebApi + the 3 gRPC services).
# Leave blank to disable Sentry. DSN: Sentry > Settings > Projects > <project> > Client Keys (DSN).
SENTRY_DSN=
