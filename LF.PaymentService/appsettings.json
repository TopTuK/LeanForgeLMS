{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "Robokassa": {
    "MerchantLogin": "CHANGE_ME",
    "Password1": "CHANGE_ME",
    "Password2": "CHANGE_ME",
    "HashAlgorithm": "SHA256",
    "IsTest": false,
    "PaymentPageUrl": "https://auth.robokassa.ru/Merchant/Index.aspx",
    "Culture": "ru",
    "SuccessUrl": "https://localhost/api/payments/robokassa/success",
    "FailUrl": "https://localhost/api/payments/robokassa/fail",
    "Fiscalization": {
      "Enabled": false,
      "Tax": "none",
      "PaymentMethod": "full_payment",
      "PaymentObject": "service"
    }
  }
}
